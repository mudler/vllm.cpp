#!/usr/bin/env bash
# Run record and public-document gates against the COMMITS BEING PUSHED.
#
# Why this exists: these gates hold budgets and shapes that are otherwise
# enforced only in CI, and a landing that breaks one turns main red for whoever
# pushes next, which is the expensive moment to find out.
# scripts/agent-preflight.sh already runs them, but it is opt-in and a
# forgotten run is exactly how 8f752ae5 reached main over two such limits.
#
# It checks the PUSHED COMMIT's worktree, not the caller's working tree:
# a dirty checkout must not fail a clean push, and an uncommitted fix must not
# let a broken commit through. This is the same content CI will see.
#
# Enable (once per clone):   git config core.hooksPath .githooks
# Bypass a single push:      git push --no-verify
#
# stdin: <local_ref> <local_sha> <remote_ref> <remote_sha> per ref.

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
ZERO='0000000000000000000000000000000000000000'

# Every name here is also a CHECKERS entry in scripts/agent-preflight.sh, and
# the loop below REFUSES a name it cannot find rather than skipping it. Three
# names outlived their files here -- check-policy.py and check-state-record.py
# (0f3e44eee), check-public-doc-tables.py (1db7e59cf, #1714) -- and this hook
# presented as six gates while running three, in silence (#1779). Delete a name
# in the change that deletes its checker.
CHECKERS=(check-prompt-contract.py check-now-current.py check-readme-structure.py)

shas=()
bases=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # A branch deletion pushes the null sha and has no tree to check.
  [ "$local_sha" = "$ZERO" ] && continue
  [ -z "$local_sha" ] && continue
  shas+=("$local_sha")
  bases+=("$remote_sha")
done

# Nothing on stdin (a hand-run, or a git that passed no refs): check HEAD.
if [ ${#shas[@]} -eq 0 ]; then
  shas=("$(git rev-parse HEAD)")
  bases=("$(git rev-parse HEAD^)")
fi

tmp="$(mktemp -d)"
worktrees=()
cleanup() {
  for worktree in "${worktrees[@]}"; do
    git -C "$ROOT" worktree remove --force "$worktree" >/dev/null 2>&1 || true
  done
  rm -rf "$tmp"
}
trap cleanup EXIT

failed=0
for index in "${!shas[@]}"; do
  sha="${shas[$index]}"
  base="${bases[$index]}"
  if [ "$base" = "$ZERO" ] || ! git -C "$ROOT" cat-file -e "${base}^{commit}" 2>/dev/null; then
    base="$(git -C "$ROOT" merge-base origin/main "$sha" 2>/dev/null || git -C "$ROOT" rev-parse "$sha^" 2>/dev/null || true)"
  fi
  work="$tmp/${sha}"
  if ! git -C "$ROOT" worktree add --quiet --detach "$work" "$sha" 2>"$tmp/.worktree-err"; then
    printf 'pre-push: could not materialize %s for checking\n' "${sha:0:12}" >&2
    sed 's/^/  /' "$tmp/.worktree-err" >&2
    failed=1
    continue
  fi
  worktrees+=("$work")
  if [ -z "$base" ]; then
    printf 'pre-push: could not resolve comparison base for %s\n' "${sha:0:12}" >&2
    failed=1
    continue
  fi
  for checker in "${CHECKERS[@]}"; do
    # NOT `|| continue`. A checker that is named and absent is the one case
    # this hook cannot read: it is either a deletion nobody pruned from the
    # list above, or a gate that went missing, and skipping it in silence makes
    # those two look identical and both look green (#1779).
    if [ ! -f "$work/scripts/$checker" ]; then
      printf 'pre-push: %s is named in CHECKERS but is not in scripts/ at %s\n' \
        "$checker" "${sha:0:12}" >&2
      printf '  Prune the name if the checker was deleted; restore the checker\n' >&2
      printf '  if it was not. A skipped gate must not read as a passing one.\n' >&2
      failed=1
      continue
    fi
    args=()
    case "$checker" in
      check-now-current.py) args=(--base "$base" --head "$sha") ;;
    esac
    if ! output="$(cd "$work" && python3 "scripts/$checker" "${args[@]}" 2>&1)"; then
      printf 'pre-push: %s FAILED on %s\n' "$checker" "${sha:0:12}" >&2
      printf '%s\n' "$output" | sed 's/^/  /' >&2
      failed=1
    fi
  done
  git -C "$ROOT" worktree remove --force "$work" >/dev/null 2>&1 || true
done

if [ "$failed" -ne 0 ]; then
  cat >&2 <<'MSG'

pre-push: refusing to push. Fix the record or pages and amend, or re-run with
--no-verify if you are deliberately pushing over the budget.
MSG
  exit 1
fi

exit 0
