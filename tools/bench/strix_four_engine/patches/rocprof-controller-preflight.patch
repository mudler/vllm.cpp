+int controller_preflight(uint32_t pid, int report_fd)
+{
+    try
+    {
+        IdentityGuard guard(pid);
+        guard.recheck();
+        auto report = guard.report(pid);
+        size_t sent = 0;
+        while(sent < report.size())
+        {
+            auto n = ::write(report_fd, report.data() + sent, report.size() - sent);
+            identity::require(n > 0, "preflight report write failed");
+            sent += n;
+        }
+        return 0;
+    }
+    catch(const std::exception& error)
+    {
+        ROCP_ERROR << "Preflight rejected: " << error.what() << '\n';
+        return 1;
+    }
+}
