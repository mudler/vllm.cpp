+bool PTraceSession::prepare_identity()
+{
+    try { m_identity = std::make_unique<IdentityGuard>(m_pid); return true; }
+    catch(const std::exception& error) {
+        ROCP_ERROR << "Attachment rejected before seizure: " << error.what() << '\n';
+        return false;
+    }
+}
